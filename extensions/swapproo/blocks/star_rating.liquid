{% comment %} 

  <div id="wishlist-root" 
     data-label="{{ block.settings.trigger_text | default: 'Trade In Your Device' | escape }}"
     data-layout-styles='{
        "widthType": "{{ block.settings.width_type | default: "full" }}",
        "customWidth": {{ block.settings.parent_width | default: 400 }},
        "display": "{{ block.settings.display | default: "inline-block" }}",
        "justifyContent": "{{ block.settings.justify_content | default: "flex-start" }}",
        "textAlign": "{{ block.settings.text_align | default: "left" }}",
        "marginTop": {{ block.settings.margin_top | default: 10 }},
        "marginBottom": {{ block.settings.margin_bottom | default: 10 }}
     }'
     data-trigger-styles='{
        "widthStyle": "{{ block.settings.trigger_width_style | default: "inline-block" }}",
        "color": "{{ block.settings.text_color | default: "#ffffff" }}",
        "bgColor": "{{ block.settings.bg_color | default: "#007ace" }}",
        "borderColor": "{{ block.settings.border_color | default: "#005a9e" }}",
        "borderWidth": {{ block.settings.border_width | default: 1 }},
        "borderRadius": {{ block.settings.border_radius | default: 8 }},
        "fontSize": {{ block.settings.font_size | default: 16 }},
        "paddingV": {{ block.settings.padding_tb | default: 12 }},
        "paddingH": {{ block.settings.padding_lr | default: 24 }},
        "showUnderline": {{ block.settings.show_underline | json }}
     }'>
</div>

{{ 'wishlist-app.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wishlist-app.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Swapproo Global Trigger",
  "target": "body",
  "settings": [
    { "type": "header", "content": "Instructions" },
    { "type": "paragraph", "content": "Any element on your site with the class 'swapproo-trigger' will now open the Trade-In drawer." },
    { "type": "header", "content": "Default Button Style" },
    { "type": "text", "id": "trigger_text", "label": "Button Label", "default": "Trade In Your Device" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#007ace" },
    { "type": "range", "id": "font_size", "min": 12, "max": 40, "step": 1, "unit": "px", "label": "Font Size", "default": 16 },
    { "type": "range", "id": "padding_tb", "min": 0, "max": 60, "step": 1, "unit": "px", "label": "Padding Vertical", "default": 12 },
    { "type": "range", "id": "padding_lr", "min": 0, "max": 60, "step": 1, "unit": "px", "label": "Padding Horizontal", "default": 24 },
    { "type": "range", "id": "border_radius", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Corner Radius", "default": 8 },
    { "type": "checkbox", "id": "show_underline", "label": "Underline Text", "default": false },
    { "type": "header", "content": "Layout (When placed as Block)" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Margin Top", "default": 10 },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Margin Bottom", "default": 10 }
  ]
}
{% endschema %} {% endcomment %}

